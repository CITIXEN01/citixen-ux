{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/beta",
      "destination": "/app?beta_cohort=alpha_10&ref=direct",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/dispatch",
      "destination": "/dispatch.html"
    },
    {
      "source": "/admin",
      "destination": "/dispatch.html"
    },
    {
      "source": "/rep",
      "destination": "/rep.html"
    },
    {
      "source": "/report/:id",
      "destination": "/report.html?id=:id"
    },
    {
      "source": "/operator/feedback",
      "destination": "/operator-feedback.html"
    },
    {
      "source": "/operator",
      "destination": "/operator.html"
    },
    {
      "source": "/((?!api/|app$|dispatch$|admin$|rep$|operator$|operator/feedback$|icons/|shared/|manifest.json|sw.js|favicon.ico|CITIXEN_UX_Executive_Deck\\.pptx).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
